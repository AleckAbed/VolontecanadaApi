# Environnement des tests de bout en bout (Playwright). Copié en .env.e2e au premier lancement.
# Base SQLite jetable, aucun courriel réel, aucun service externe.
APP_NAME="Volonte Canada E2E"
APP_ENV=e2e
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001
FRONTEND_URL=http://localhost:3101
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

LOG_CHANNEL=single
LOG_LEVEL=warning

# DB_DATABASE (chemin absolu de database/e2e.sqlite) est fourni par Playwright.
DB_CONNECTION=sqlite

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=sync
MAIL_MAILER=array
MAIL_FROM_ADDRESS="noreply@e2e.test"
MAIL_FROM_NAME="${APP_NAME}"
DOCUMENTS_DISK=local
BACKUP_DISK=local

STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SEAT=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SENTRY_LARAVEL_DSN=
