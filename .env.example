APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# URL du frontend (Next.js) pour les liens dans les emails (invitation questionnaire). En prod : https://volontecanadaplateforme.vercel.app
FRONTEND_URL=http://localhost:3001
# Autres adresses autorisées à appeler l'API (CORS), séparées par des virgules.
CORS_EXTRA_ORIGINS=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Courriels en file d'attente : en production, un worker « php artisan queue:work » doit tourner.
# En développement sans worker : QUEUE_CONNECTION=sync (envoi immédiat).
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Envoi des liens formulaires aux clients (SMTP). IMAP = réception uniquement.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@votredomaine.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Stripe (S6) — compte de la plateforme. Sans STRIPE_SECRET, les paiements en
# ligne sont désactivés (facturation et paiements notés à la main restent possibles).
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
# Prix Stripe (récurrent, par unité) facturé par siège = compte actif du personnel
STRIPE_PRICE_SEAT=
# Commission de la plateforme sur les paiements des clients (0 = aucune)
STRIPE_PLATFORM_FEE_PERCENT=0
SUBSCRIPTION_TRIAL_DAYS=30

# Google Agenda + Meet (S7) — application OAuth « Web » de la plateforme (Google Cloud).
# URI de redirection autorisée à déclarer : {APP_URL}/api/google/callback
# Sans ces clés, la réservation fonctionne sans synchronisation Google ni lien Meet.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/google/callback"

# --- Documents des clients (S8, 2.5) ---
# local = storage/app/private (développement). En production : documents_s3, un stockage
# objet HÉBERGÉ AU CANADA (AWS ca-central-1, OVHcloud BHS, DigitalOcean TOR1…), chiffré.
DOCUMENTS_DISK=local
DOCUMENTS_S3_KEY=
DOCUMENTS_S3_SECRET=
DOCUMENTS_S3_REGION=ca-central-1
DOCUMENTS_S3_BUCKET=
# Laisser vide pour AWS ; ex. https://s3.bhs.io.cloud.ovh.net ou https://tor1.digitaloceanspaces.com
DOCUMENTS_S3_ENDPOINT=
DOCUMENTS_S3_PATH_STYLE=false

# --- Sauvegardes de la base (S8, 2.12) ---
# Clé : php artisan backup:key — en garder une copie HORS du serveur (sinon sauvegardes illisibles).
BACKUP_ENCRYPTION_KEY=
# backups_local (storage/app/backups) ou backups_s3 (autre compartiment, au Canada)
BACKUP_DISK=backups_local
BACKUP_S3_BUCKET=
BACKUP_KEEP_DAYS=30
# Sous XAMPP : C:/xampp/mysql/bin/mysqldump.exe
BACKUP_MYSQLDUMP_PATH=mysqldump
